{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agridata-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // 1. Cloudflare Smart Placement (Free: executes Worker close to ap-southeast-1 Neon DB)
  "placement": {
    "mode": "smart"
  },
  // 2. Cloudflare Free Tier D1 Serverless SQL (5 GB Free, 5M reads/day, 100k writes/day)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agridata_edge_db",
      "database_id": "local-agridata-edge-db"
    }
  ],
  // 3. Cloudflare Free Tier Workers KV (1 GB Free, 100k reads/day, 1k writes/day)
  "kv_namespaces": [
    {
      "binding": "KV_CACHE",
      "id": "local-agridata-kv"
    }
  ],
  // 4. Cloudflare Free Tier R2 Object Storage (10 GB Free, 1M Class A, 10M Class B, 0 Egress)
  // Stores Immutable Forecast Audit Vault (Gate G6), Raw Market HTML/JSON Archives & B2B Contracts
  "r2_buckets": [
    {
      "binding": "R2_VAULT",
      "bucket_name": "agridata-immutable-vault"
    }
  ],
  // 5. Cloudflare Free Tier Hyperdrive (Free PostgreSQL Edge Connection Pooler & Query Cache)
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "local-agridata-hyperdrive",
      "localConnectionString": "postgresql://agridata:local_dev_placeholder@localhost:5432/neondb"
    }
  ],
  // 6. Cloudflare Free Tier Workers AI (10,000 Neurons/day Free - Llama 3.1 8B & BGE-M3 Embeddings)
  "ai": {
    "binding": "AI"
  },
  // 7. Cloudflare Free Tier Vectorize (30M queried vector dimensions/mo, 5M stored dimensions Free)
  "vectorize": [
    {
      "binding": "VECTORIZE_AGRI_KB",
      "index_name": "agridata-agronomy-kb"
    }
  ],
  // 8. Cloudflare Free Tier Workers Analytics Engine (100k data points/day Free Telemetry)
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS_ENGINE",
      "dataset": "agridata_edge_telemetry"
    }
  ],
  // 9. Scheduled Cron Trigger for Automated Market & Weather Crawling (4:00 AM UTC Daily)
  "triggers": {
    "crons": ["0 4 * * *"]
  }
}
