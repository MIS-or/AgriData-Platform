{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agridata-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // [Goal G0 & X6] Smart Placement: executes Worker close to ap-southeast-1 Neon PostgreSQL
  "placement": {
    "mode": "smart"
  },
  // [Goal G2 & G4] Cloudflare D1 Serverless SQL (5 GB Free): Edge cache for hot prices & offline sync
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agridata_edge_db",
      "database_id": "local-agridata-edge-db"
    }
  ],
  // [Goal G4, G5 & X4] Cloudflare Workers KV (1 GB Free): Anti-Herd 25% saturation counter & Marts cache
  "kv_namespaces": [
    {
      "binding": "KV_CACHE",
      "id": "local-agridata-kv"
    }
  ],
  // [Goal G1, G6 & G7] Cloudflare R2 Object Storage (10 GB Free, 0 Egress):
  // Immutable Tier-1 Raw Market/Farmer Logs & Gate G6 SHA-256 Forecast Audit Vault
  "r2_buckets": [
    {
      "binding": "R2_VAULT",
      "bucket_name": "agridata-immutable-vault"
    }
  ],
  // [Goal G2, G3 & X6] Cloudflare Hyperdrive (Free): Connection pooling & query cache for Neon PostgreSQL
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "local-agridata-hyperdrive",
      "localConnectionString": "postgresql://agridata:local_dev_placeholder@localhost:5432/neondb"
    }
  ],
  // [Goal G1] Scheduled Cron Trigger for Automated Market & Weather Crawling (4:00 AM UTC Daily)
  "triggers": {
    "crons": ["0 4 * * *"]
  }
}
