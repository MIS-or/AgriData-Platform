# ====================================================================
# AgriData Platform - Single Root Environment Variables Template
# All cloud services operate under Cloudflare & Neon 100% Free Tiers
# ====================================================================
# SECURITY & ARCHITECTURE POLICY:
# - Single Source of Truth: ONLY ONE `.env` file at the repository root.
# - Do NOT create `.env` or `.dev.vars` inside subdirectories (`apps/*`, `packages/*`).
# - NEVER commit `.env` or real secrets to Git or bake them into Docker images!
# - Production (Cloudflare Workers): `wrangler secret put <SECRET_NAME>`
# - Production (Cloudflare Pages): Configure in Pages > Settings > Environment Variables.
# ====================================================================

# --------------------------------------------------------------------
# 1. CLOUDFLARE FULL FREE TIER ECOSYSTEM (10 Services - 0 VND/Month)
# --------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ZONE_ID=

# 1.1 Cloudflare D1 Serverless SQL (5 GB Free, 5M reads/day, 100k writes/day)
CLOUDFLARE_D1_DATABASE_ID=local-agridata-edge-db

# 1.2 Cloudflare Workers KV (1 GB Free, 100k reads/day, 1k writes/day)
CLOUDFLARE_KV_NAMESPACE_ID=local-agridata-kv

# 1.3 Cloudflare R2 Object Storage (10 GB Free, 1M Class A, 10M Class B, 0 Egress)
CLOUDFLARE_R2_BUCKET_NAME=agridata-immutable-vault

# 1.4 Cloudflare Hyperdrive (Free Edge Connection Pooler & Query Cache for Neon Postgres)
CLOUDFLARE_HYPERDRIVE_ID=local-agridata-hyperdrive

# 1.5 Cloudflare Vectorize (Free 30M queried dimensions/mo, 5M stored dimensions)
CLOUDFLARE_VECTORIZE_INDEX_NAME=agridata-agronomy-kb

# 1.6 Cloudflare Workers AI (Free 10,000 Neurons/day - @cf/meta/llama-3.1-8b-instruct)
CLOUDFLARE_WORKERS_AI_DAILY_NEURON_LIMIT=8000

# 1.7 Cloudflare Workers Analytics Engine (Free 100k data points/day)
CLOUDFLARE_ANALYTICS_DATASET=agridata_edge_telemetry

# 1.8 Cloudflare Turnstile Bot Protection (Unlimited Free Widgets & Verifications)
# Note: 1x0000000000000000000000000000000AA is Cloudflare's official always-pass test key
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --------------------------------------------------------------------
# 2. NEON SERVERLESS POSTGRESQL (3-Tier Data Warehouse: Raw / Clean / Marts)
# --------------------------------------------------------------------
# Pooled connection string for Cloudflare Workers Edge runtime (ap-southeast-1)
NEON_DATABASE_URL=postgres://user:password@ep-sample-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Unpooled direct connection string for DDL / schema migrations
NEON_DIRECT_DATABASE_URL=postgres://user:password@ep-sample-123456-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
NEON_PROJECT_ID=agridata-prod-branch

# --------------------------------------------------------------------
# 3. DATA GOVERNANCE & FARMER PII PROTECTION (Nghị định 13/2023/NĐ-CP - X3)
# --------------------------------------------------------------------
# Cryptographic salt (min 32 chars) for irreversible SHA-256 hashing of farmer phone numbers
PII_HASH_SALT=your_random_cryptographic_pii_salt_at_least_32_chars_long
# Symmetric encryption key (64 hex chars = 32 bytes) for AES-256-GCM field protection
DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --------------------------------------------------------------------
# 4. API SECURITY & WEBHOOK VERIFICATION
# --------------------------------------------------------------------
# Bearer secret token protecting administrative, forecast-vault seal, and ops endpoints
INTERNAL_API_SECRET=your_super_secret_internal_api_token_here
# HMAC-SHA256 secret key for verifying incoming market/partner webhooks
WEBHOOK_SIGNING_SECRET=your_webhook_hmac_signing_secret_here

# --------------------------------------------------------------------
# 5. COOPERATIVE & FARMER COMMUNICATION (Zalo OA - Gate G5)
# --------------------------------------------------------------------
ZALO_OA_ACCESS_TOKEN=your_zalo_oa_access_token_here
ZALO_OA_SECRET_KEY=your_zalo_oa_app_secret_here

# --------------------------------------------------------------------
# 6. FRONTEND PWA & EDGE GATEWAY RUNTIME
# --------------------------------------------------------------------
# Leave empty in local development to use Vite proxy (/api -> 127.0.0.1:8787)
VITE_API_BASE_URL=
# Cloudflare Turnstile public site key (1x00000000000000000000AA is official test site key)
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
NODE_ENV=development

# --------------------------------------------------------------------
# 7. DOCKER LOCAL TEST & WAREHOUSE SIMULATION
# --------------------------------------------------------------------
POSTGRES_USER=agridata
POSTGRES_PASSWORD=your_local_docker_postgres_password
POSTGRES_DB=neondb
POSTGRES_PORT=5432
API_PORT=8787
WEB_PORT=8080
